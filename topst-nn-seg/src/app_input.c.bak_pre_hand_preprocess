#define FACE_PREPROCESS_OFF            0
#define FACE_PREPROCESS_BGR_MEAN       1
#define FACE_PREPROCESS_BGR_MEAN_Q075  2
#define FACE_PREPROCESS_RGB_MEAN       3
#define FACE_PREPROCESS_RGB_01         4
#define FACE_PREPROCESS_BGR_01         5

static int8_t quantize_face_input(float value, float scale)
{
    int q = (int)(value >= 0.0f ?
                      (value * scale + 0.5f) :
                      (value * scale - 0.5f));

    if (q > 127) {
        q = 127;
    } else if (q < -128) {
        q = -128;
    }

    return (int8_t)q;
}

static int get_face_preprocess_mode(void)
{
    const char *mode = getenv("FACE_PREPROCESS");

    if (mode == NULL || mode[0] == '\0' || strcmp(mode, "off") == 0) {
        return FACE_PREPROCESS_OFF;
    }
    if (strcmp(mode, "off") == 0) {
        return FACE_PREPROCESS_OFF;
    }
    if (strcmp(mode, "bgr_mean") == 0) {
        return FACE_PREPROCESS_BGR_MEAN;
    }
    if (strcmp(mode, "bgr_mean_q075") == 0) {
        return FACE_PREPROCESS_BGR_MEAN_Q075;
    }
    if (strcmp(mode, "rgb_mean") == 0) {
        return FACE_PREPROCESS_RGB_MEAN;
    }
    if (strcmp(mode, "rgb_01") == 0) {
        return FACE_PREPROCESS_RGB_01;
    }
    if (strcmp(mode, "bgr_01") == 0) {
        return FACE_PREPROCESS_BGR_01;
    }

    fprintf(stderr,
            "[face-preprocess] unknown FACE_PREPROCESS=%s, use off\n",
            mode);
    return FACE_PREPROCESS_OFF;
}

static const char *face_preprocess_mode_name(int mode)
{
    switch (mode) {
    case FACE_PREPROCESS_OFF:
        return "off";
    case FACE_PREPROCESS_BGR_MEAN:
        return "bgr_mean";
    case FACE_PREPROCESS_BGR_MEAN_Q075:
        return "bgr_mean_q075";
    case FACE_PREPROCESS_RGB_MEAN:
        return "rgb_mean";
    case FACE_PREPROCESS_RGB_01:
        return "rgb_01";
    case FACE_PREPROCESS_BGR_01:
        return "bgr_01";
    default:
        return "unknown";
    }
}

static void dump_face_input_once(const char *env_name, const uint8_t *buf, int size)
{
    static int raw_dumped = 0;
    static int preproc_dumped = 0;
    int *dumped;
    const char *path;
    FILE *fp;
    size_t written;

    if (buf == NULL || size <= 0) {
        return;
    }

    if (strcmp(env_name, "FACE_DUMP_INPUT_RAW") == 0) {
        dumped = &raw_dumped;
    } else {
        dumped = &preproc_dumped;
    }

    if (*dumped) {
        return;
    }

    path = getenv(env_name);
    if (path == NULL || path[0] == '\0') {
        return;
    }

    fp = fopen(path, "wb");
    if (fp == NULL) {
        perror("[face-input-dump] fopen");
        *dumped = 1;
        return;
    }

    written = fwrite(buf, 1, (size_t)size, fp);
    fclose(fp);
    if (written != (size_t)size) {
        fprintf(stderr,
                "[face-input-dump] short write: %s wrote %zu bytes, expected %d\n",
                path, written, size);
    } else {
        printf("[face-input-dump] wrote %s (%d bytes) from %s\n",
               path, size, env_name);
    }

    *dumped = 1;
}

static void preprocess_faceboxes_input(uint8_t *buf, int width, int height)
{
    static int printed = 0;
    int x;
    int y;
    int mode = get_face_preprocess_mode();
    float quant_scale = 1.0f;

    if (buf == NULL || width <= 0 || height <= 0) {
        return;
    }

    if (!printed) {
        printf("[face-preprocess] mode=%s width=%d height=%d\n",
               face_preprocess_mode_name(mode), width, height);
        printed = 1;
    }

    if (mode == FACE_PREPROCESS_OFF) {
        return;
    }

    if (mode == FACE_PREPROCESS_BGR_MEAN_Q075) {
        quant_scale = 0.75f;
    }

    /*
     * FaceBoxes reference preprocessing uses OpenCV BGR order and subtracts
     * mean (104, 117, 123). The app/scaler input buffer is RGB888, so the
     * default bgr_mean mode writes:
     *   output[0] = B - 104
     *   output[1] = G - 117
     *   output[2] = R - 123
     *
     * rgb_01/bgr_01 modes are kept only for experiments with models converted
     * for normalized 0..1 inputs.
     */
    for (y = 0; y < height; ++y) {
        for (x = 0; x < width; ++x) {
            uint8_t *p = &buf[((size_t)y * (size_t)width + (size_t)x) * 3u];
            uint8_t r = p[0];
            uint8_t g = p[1];
            uint8_t b = p[2];

            if (mode == FACE_PREPROCESS_RGB_01) {
                p[0] = (uint8_t)quantize_face_input((float)r * (128.0f / 255.0f), 1.0f);
                p[1] = (uint8_t)quantize_face_input((float)g * (128.0f / 255.0f), 1.0f);
                p[2] = (uint8_t)quantize_face_input((float)b * (128.0f / 255.0f), 1.0f);
            } else if (mode == FACE_PREPROCESS_BGR_01) {
                p[0] = (uint8_t)quantize_face_input((float)b * (128.0f / 255.0f), 1.0f);
                p[1] = (uint8_t)quantize_face_input((float)g * (128.0f / 255.0f), 1.0f);
                p[2] = (uint8_t)quantize_face_input((float)r * (128.0f / 255.0f), 1.0f);
            } else if (mode == FACE_PREPROCESS_RGB_MEAN) {
                p[0] = (uint8_t)quantize_face_input((float)r - 123.0f, quant_scale);
                p[1] = (uint8_t)quantize_face_input((float)g - 117.0f, quant_scale);
                p[2] = (uint8_t)quantize_face_input((float)b - 104.0f, quant_scale);
            } else {
                p[0] = (uint8_t)quantize_face_input((float)b - 104.0f, quant_scale);
                p[1] = (uint8_t)quantize_face_input((float)g - 117.0f, quant_scale);
                p[2] = (uint8_t)quantize_face_input((float)r - 123.0f, quant_scale);
            }
        }
    }
}

static int load_face_input_bin_if_requested(const model_context_t *model)
{
    static int printed = 0;
    const char *path;
    uint8_t *dst;
    FILE *fp;
    long file_size;
    size_t read_size;

    if (model->post_type != TELECHIPS_NPU_POST_CUSTOM ||
        model->custom_result_kind != APP_CUSTOM_RESULT_FACE) {
        return 0;
    }

    path = getenv("FACE_INPUT_BIN");
    if (path == NULL || path[0] == '\0') {
        return 0;
    }

    dst = (uint8_t *)buffer_get_addr(model->input_buf);
    if (dst == NULL) {
        fprintf(stderr, "[face-input-bin] model input buffer is NULL\n");
        return -1;
    }

    fp = fopen(path, "rb");
    if (fp == NULL) {
        perror("[face-input-bin] fopen");
        return -1;
    }

    if (fseek(fp, 0, SEEK_END) != 0) {
        perror("[face-input-bin] fseek");
        fclose(fp);
        return -1;
    }
    file_size = ftell(fp);
    if (file_size < 0) {
        perror("[face-input-bin] ftell");
        fclose(fp);
        return -1;
    }
    rewind(fp);

    if (file_size != model->input_size) {
        fprintf(stderr,
                "[face-input-bin] size mismatch: %s has %ld bytes, model input expects %d bytes\n",
                path, file_size, model->input_size);
        fclose(fp);
        return -1;
    }

    read_size = fread(dst, 1, (size_t)model->input_size, fp);
    fclose(fp);
    if (read_size != (size_t)model->input_size) {
        fprintf(stderr,
                "[face-input-bin] short read: got %zu bytes, expected %d bytes\n",
                read_size, model->input_size);
        return -1;
    }

    if (!printed) {
        printf("[face-input-bin] using preprocessed input: %s (%d bytes)\n",
               path, model->input_size);
        printed = 1;
    }

    return 1;
}

static int recv_all(int fd, uint8_t *buf, size_t size)
{
    size_t received = 0;

    /* TCP는 바이트 스트림이므로 프레임 1장이 여러 recv() 조각으로 나뉘어 들어올 수 있음. */
    while (received < size) {
        ssize_t ret = recv(fd, buf + received, size - received, 0);
        if (ret == 0) {
            return 0;
        }
        if (ret < 0) {
            if (errno == EINTR) {
                continue;
            }
            return -1;
        }
        received += (size_t)ret;
    }

    return 1;
}

static int tcp_input_init(tcp_input_context_t *ctx, int port, size_t frame_bytes)
{
    struct sockaddr_in serv_addr;
    int opt = 1;

    memset(ctx, 0, sizeof(*ctx));
    ctx->server_fd = -1;
    ctx->client_fd = -1;
    ctx->port = port;
    ctx->frame_bytes = frame_bytes;

    ctx->frame_buffer = (uint8_t *)malloc(frame_bytes);
    if (ctx->frame_buffer == NULL) {
        fprintf(stderr, "failed to allocate TCP frame buffer (%zu bytes)\n", frame_bytes);
        return -1;
    }

    ctx->server_fd = socket(AF_INET, SOCK_STREAM, 0);
    if (ctx->server_fd < 0) {
        perror("socket");
        return -1;
    }

    (void)setsockopt(ctx->server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    memset(&serv_addr, 0, sizeof(serv_addr));
    serv_addr.sin_family = AF_INET;
    serv_addr.sin_addr.s_addr = htonl(INADDR_ANY);
    serv_addr.sin_port = htons((uint16_t)port);

    if (bind(ctx->server_fd, (struct sockaddr *)&serv_addr, sizeof(serv_addr)) < 0) {
        perror("bind");
        return -1;
    }
    if (listen(ctx->server_fd, 1) < 0) {
        perror("listen");
        return -1;
    }

    printf("[tcp] listening on port %d for %zubyte RGB frames\n", port, frame_bytes);
    return 0;
}

static int tcp_accept_client(tcp_input_context_t *ctx)
{
    struct sockaddr_in cli_addr;
    socklen_t cli_len = sizeof(cli_addr);

    ctx->client_fd = accept(ctx->server_fd, (struct sockaddr *)&cli_addr, &cli_len);
    if (ctx->client_fd < 0) {
        if (errno == EINTR) {
            return 0;
        }
        perror("accept");
        return -1;
    }

    printf("[tcp] client connected: %s:%d\n",
           inet_ntoa(cli_addr.sin_addr), ntohs(cli_addr.sin_port));
    return 1;
}

int app_input_init(app_context_t *app)
{
    if (app->input_mode != APP_INPUT_TCP) {
        return 0;
    }

    if (tcp_input_init(&app->tcp_input, app->tcp_input.port,
                       (size_t)app->camera_width * (size_t)app->camera_height * 3u) != 0) {
        return -1;
    }

    app->tcp_stage_buf = buffer_alloc(app->models[0].npu,
                                      (int)((size_t)app->camera_width *
                                            (size_t)app->camera_height * 3u));
    if (app->tcp_stage_buf == NULL) {
        fprintf(stderr, "failed to allocate tcp staging buffer\n");
        return -1;
    }

    return 0;
}

void app_input_deinit(app_context_t *app)
{
    if (app->tcp_input.client_fd >= 0) {
        (void)close(app->tcp_input.client_fd);
        app->tcp_input.client_fd = -1;
    }
    if (app->tcp_input.server_fd >= 0) {
        (void)close(app->tcp_input.server_fd);
        app->tcp_input.server_fd = -1;
    }
    free(app->tcp_input.frame_buffer);
    app->tcp_input.frame_buffer = NULL;
    app->tcp_input.frame_bytes = 0;
}

int acquire_input_frame(app_context_t *app)
{
    if (app->input_mode == APP_INPUT_CAMERA) {
        if (camera_get_buffer(app->camera, &app->camera_virt_addr,
                              &app->camera_phys_addr) <= 0) {
            usleep(1000);
            return 0;
        }
        return 1;
    }

    /* TCP 모드에서는 frame_buffer에 RGB 프레임 1장이 모두 채워질 때까지 대기 */
    for (;;) {
        int ret;

        if (app->stop) {
            return -1;
        }
        if (app->tcp_input.client_fd < 0) {
            ret = tcp_accept_client(&app->tcp_input);
            if (ret < 0) {
                return -1;
            }
            if (ret == 0) {
                continue;
            }
        }

        ret = recv_all(app->tcp_input.client_fd, app->tcp_input.frame_buffer,
                       app->tcp_input.frame_bytes);
        if (ret > 0) {
            return 1;
        }

        (void)close(app->tcp_input.client_fd);
        app->tcp_input.client_fd = -1;
        if (ret < 0) {
            perror("recv");
        } else {
            printf("[tcp] client disconnected\n");
        }
    }
}

void release_input_frame(app_context_t *app)
{
    if (app->input_mode == APP_INPUT_CAMERA && app->camera != NULL) {
        (void)camera_release_buffer(app->camera);
    }
}

int prepare_model_input(app_context_t *app, const model_context_t *model,
                        scaler_index_t scaler_index)
{
    int bin_ret = load_face_input_bin_if_requested(model);
    if (bin_ret != 0) {
        return bin_ret > 0 ? 0 : -1;
    }

    if (app->input_mode == APP_INPUT_CAMERA) {
        scaler_image_t src;
        scaler_image_t dst;

        /* 카메라 입력은 캡처된 물리 버퍼에서 바로 리사이즈할 수 있다. */
        src.paddr = app->camera_phys_addr;
        src.width = app->camera_width;
        src.height = app->camera_height;
        src.format = SCALER_FORMAT_ARGB8888;

        dst.paddr = model->input_buf->paddr;
        dst.width = app_align_width((uint32_t)model->input_width, 16u);
        dst.height = (uint32_t)model->input_height;
        dst.format = SCALER_FORMAT_RGB888;

        if (scaler_resize(app->scaler, scaler_index, src, dst) != 0) {
            return -1;
        }

        if (scaler_poll(app->scaler, scaler_index) != 0) {
            return -1;
        }

        if (model->post_type == TELECHIPS_NPU_POST_CUSTOM &&
            model->custom_result_kind == APP_CUSTOM_RESULT_FACE) {
            uint8_t *input_addr = (uint8_t *)buffer_get_addr(model->input_buf);
            dump_face_input_once("FACE_DUMP_INPUT_RAW", input_addr, model->input_size);
            preprocess_faceboxes_input(input_addr, model->input_width, model->input_height);
            dump_face_input_once("FACE_DUMP_INPUT_PREPROC", input_addr, model->input_size);
        }

        return 0;
    }

    {
        scaler_image_t src;
        scaler_image_t dst;
        unsigned char *stage_addr;

        /*
         * TCP 입력은 일반 호스트 메모리이므로, 하드웨어 스케일러가 읽기 전에
         * NPU가 소유한 staging buffer로 한 번 복사
         */
        if (app->tcp_stage_buf == NULL) {
            return -1;
        }

        stage_addr = (unsigned char *)buffer_get_addr(app->tcp_stage_buf);
        if (stage_addr == NULL) {
            return -1;
        }

        memcpy(stage_addr, app->tcp_input.frame_buffer, app->tcp_input.frame_bytes);

        src.paddr = app->tcp_stage_buf->paddr;
        src.width = app->camera_width;
        src.height = app->camera_height;
        src.format = SCALER_FORMAT_RGB888;

        dst.paddr = model->input_buf->paddr;
        dst.width = app_align_width((uint32_t)model->input_width, 16u);
        dst.height = (uint32_t)model->input_height;
        dst.format = SCALER_FORMAT_RGB888;

        if (scaler_resize(app->scaler, scaler_index, src, dst) != 0) {
            return -1;
        }

        if (scaler_poll(app->scaler, scaler_index) != 0) {
            return -1;
        }

        if (model->post_type == TELECHIPS_NPU_POST_CUSTOM &&
            model->custom_result_kind == APP_CUSTOM_RESULT_FACE) {
            uint8_t *input_addr = (uint8_t *)buffer_get_addr(model->input_buf);
            dump_face_input_once("FACE_DUMP_INPUT_RAW", input_addr, model->input_size);
            preprocess_faceboxes_input(input_addr, model->input_width, model->input_height);
            dump_face_input_once("FACE_DUMP_INPUT_PREPROC", input_addr, model->input_size);
        }

        return 0;
    }
}
